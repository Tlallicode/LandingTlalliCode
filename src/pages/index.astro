---
import Layout from '../layouts/Layout.astro';

const kits = [
  {
    name: 'Kit: El Secreto del Hospicio',
    label: 'Edición limitada',
    description: 'Cinco cartas de personajes, un mapa de ruinas y un token de historia con pistas ocultas.',
    price: '$170 MXN',
    accent: 'copper',
    icon: 'N',
  },
  {
    name: 'Más Kits en camino',
    label: 'Pronto',
    description: 'Sigue atento a nuestras redes sociales para descubrir los próximos kits de exploración y cartas coleccionables.',
    price: '',
    accent: 'gold',
    icon: 'P',
  }
];

const galleryCards = [
  {
    title: 'Pancho Villa',
    role: 'Comandante de la ciudad',
    rarity: 'Legendaria',
    lore: 'El Centauro del norte que no pidió permiso a la historia, sino que la tomó por asalto a lomo de caballo. Sus hazañas llevaron un ejercito extranjero al desierto sin jamás encontrarlo.',
    stats: ['Fuerza 9', 'Lealtad 8', 'Historia 10'],
    image:
      '/pancho_villa.png',
  },
  {
    title: 'Julian Medina',
    role: 'General de armada',
    rarity: 'Ultra rara',
    lore: 'Una sombra a galope que vistió a occidente con la tormenta del norte. El gobernador que no dictó su voluntad con tinta ni tronos, sino con el polvo y el acero de sus batallas.',
    stats: ['Sabiduría 10', 'Perspicacia 9', 'Voz 8'],
    image:
      '/julian_medina.png',
  },
  {
    title: 'Jesús Medina',
    role: 'Soldado Mexicano',
    rarity: 'Épica',
    lore: 'Un destello de plomo rebelde silenció al palacio. El que no disparó contra el metal, sino al tiempo mismo. Allá arriba aún se asoma la cicatriz de su impaciencia.',
    stats: ['Rebeldía 9', 'Estética 10', 'Resistencia 7'],
    image:
      '/jesus_medina.png',
  }
];
---

<Layout title="Nehnemi | Colecciona la historia de Guadalajara" description="Landing page de Nehnemi con kits de exploración, cartas coleccionables, personajes históricos y newsletter para captar leads.">
  <main class="page-shell">
    <header class="topbar">
      <div class="brand-block" aria-label="Nehnemi logo">
        <span class="brand-mark">N</span>
        <span>Nehnemi</span>
      </div>

      <nav class="topnav" aria-label="Navegación principal">
        <a href="#kits">Kits</a>
        <a href="#personajes">Personajes</a>
        <a href="#newsletter">Sociedad</a>
      </nav>

      <a class="nav-cta" href="#kits">Ver tienda/Kits</a>
    </header>

    <section class="hero section-shell" id="hero">
      <div class="hero-copy">
        <span class="hero-tag">Coleccionables históricos · Guadalajara</span>
        <h1>La historia de la ciudad está en tus manos.</h1>
        <p>
          Descubre kits de exploración, cartas de personajes ilustres y misterios del pasado de
          Guadalajara listos para coleccionar, jugar y compartir.
        </p>

        <div class="hero-actions">
          <a class="primary-button" href="#kits">Explorar los Kits</a>
          <a class="secondary-button" href="#personajes">Conoce a los Personajes</a>
        </div>

        <ul class="hero-stats" aria-label="Estadísticas de la colección">
          <li>
            <strong>3+</strong>
            <span>cartas únicas</span>
          </li>
          <li>
            <strong>1</strong>
            <span>kit básico y más pronto</span>
          </li>
          <li>
            <strong>Únete</strong>
            <span>a nuestra newsletter</span>
          </li>
        </ul>
      </div>

      <div class="hero-visual" aria-label="Composición de cartas de colección Nehnemi">
        <article class="trading-card trading-card--main">
          <div class="card-frame">
            <div class="card-header">
              <span class="mini-tag">Legendaria</span>
              <span class="card-code">NEH-07</span>
            </div>
            <div class="card-art card-art--main">
              <div class="art-sheen"></div>
            </div>
            <div class="card-body">
              <p>Personaje</p>
              <h2>Pancho Villa</h2>
            </div>
          </div>
        </article>

        <article class="trading-card trading-card--left">
          <div class="card-frame">
            <div class="card-header">
              <span class="mini-tag">Épica</span>
              <span class="card-code">NEH-11</span>
            </div>
            <div class="card-art card-art--left">
              <div class="art-sheen"></div>
            </div>
            <div class="card-body">
              <p>Personaje</p>
              <h2>Jesús Medina</h2>
            </div>
          </div>
        </article>

        <article class="trading-card trading-card--right">
          <div class="card-frame">
            <div class="card-header">
              <span class="mini-tag">Ultra rara</span>
              <span class="card-code">NEH-19</span>
            </div>
            <div class="card-art card-art--right">
              <div class="art-sheen"></div>
            </div>
            <div class="card-body">
              <p>Personaje</p>
              <h2>Julian Medina</h2>
            </div>
          </div>
        </article>

        <div class="floating-badge">
          <span>EDICIÓN LIMITADA</span>
          <strong>2026</strong>
        </div>
      </div>
    </section>

    <section class="section-shell" id="kits">
      <div class="section-heading">
        <span class="eyebrow">Nuestros Kits</span>
        <h2>Artefactos para explorar la ciudad</h2>
      </div>

      <div class="kits-grid">
        {kits.map((kit) => (
          <article class="kit-card">
            <div class={`kit-art kit-art--${kit.accent}`}>
              <div class="kit-icon">{kit.icon}</div>
              <span class="kit-badge">{kit.label}</span>
            </div>
            <div class="kit-content">
              <h3>{kit.name}</h3>
              <p>{kit.description}</p>
              <div class="kit-footer">
                <strong>{kit.price}</strong>
                <button class="kit-trigger" type="button" data-kit-name={kit.name} data-kit-price={kit.price} data-kit-label={kit.label} data-kit-description={kit.description} aria-label={`Ver más información de ${kit.name}`}>
                  Ver kit
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="story-band" aria-label="Narrativa de Nehnemi">
      <div class="story-copy">
        <span class="eyebrow">El universo Nehnemi</span>
        <h2>No solo juegas; descubres la memoria de la ciudad.</h2>
      </div>
      <div class="story-points">
        <div>
          <strong>06</strong>
          <span>historias ocultas</span>
        </div>
        <div>
          <strong>14</strong>
          <span>lugares reales</span>
        </div>
        <div>
          <strong>∞</strong>
          <span>misterios por revelar</span>
        </div>
      </div>
    </section>

    <section class="section-shell" id="personajes">
      <div class="section-heading">
        <span class="eyebrow">Galería de Cartas</span>
        <h2>Personajes que dejaron huella en la ciudad</h2>
      </div>

      <div class="carousel" aria-label="Carrusel de personajes">
        <button class="carousel-control" type="button" data-dir="prev" aria-label="Carta anterior">←</button>

        <div class="carousel-window">
          {galleryCards.map((card, index) => (
            <article
              class={`character-card ${index === 0 ? 'is-active' : ''}`}
              data-index={index}
              aria-label={`Carta de ${card.title}`}
            >
              <div class="character-card-inner">
                <div class="character-card-face character-card-front">
                  <div class="card-topline">
                    <span class="rarity">{card.rarity}</span>
                    <span class="card-number">0{index + 1}</span>
                  </div>
                  <div class="portrait" style={`background-image: url('${card.image}')`}></div>
                  <div class="front-copy">
                    <p>{card.role}</p>
                    <h3>{card.title}</h3>
                  </div>
                  <ul class="stat-row">
                    {card.stats.map((stat) => <li>{stat}</li>)}
                  </ul>
                </div>

                <div class="character-card-face character-card-back">
                  <span class="back-label">Historia</span>
                  <h3>{card.title}</h3>
                  <p>{card.lore}</p>
                  <div class="back-meta">
                    <span>{card.role}</span>
                    <span>{card.rarity}</span>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>

        <button class="carousel-control" type="button" data-dir="next" aria-label="Siguiente carta">→</button>
      </div>

      <div class="carousel-indicators" aria-label="Indicadores del carrusel">
        {galleryCards.map((card, index) => (
          <button class={`indicator ${index === 0 ? 'is-active' : ''}`} type="button" data-index={index} aria-label={`Ir a ${card.title}`}>
            <span>{index + 1}</span>
          </button>
        ))}
      </div>
    </section>

    <section class="section-shell newsletter-shell" id="newsletter">
      <div class="newsletter-panel">
        <div class="newsletter-copy">
          <span class="eyebrow">Únete a la Sociedad de Cronistas</span>
          <h2>Descubre los secretos detrás del desarrollo de Nehnemi.</h2>
          <p>
            Recibe adelantos exclusivos de futuras cartas, historias ocultas de la ciudad y acceso
            anticipado a los próximos lanzamientos antes que nadie.
          </p>
        </div>

        <form class="newsletter-form" id="newsletter-form" novalidate>
          <label>
            <span>Tu nombre</span>
            <input type="text" name="name" placeholder="Escribe tu nombre" required />
          </label>
          <label>
            <span>Tu correo electrónico</span>
            <input type="email" name="email" placeholder="correo@ejemplo.com" required />
          </label>
          <button type="submit" class="primary-button">Revelar el pasado</button>
          <p class="form-status" id="newsletter-message" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-top">
      <div>
        <div class="brand-block footer-brand">
          <span class="brand-mark">N</span>
          <span>Nehnemi</span>
        </div>
        <p>Fomentando historias, coleccionables y exploración cultural en la ciudad.</p>
      </div>

      <div class="footer-links">
        <div>
          <h3>Redes</h3>
          <ul>
            <li><a href="https://instagram.com/tlallicode" target="_blank" rel="noreferrer noopener">Instagram</a></li>
            <li><a href="mailto:a23310134@ceti.mx">Contacto</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© 2026 Tlallicode</span>
      <span>Nehnemi x Tlallicode</span>
    </div>
  </footer>

  <div class="kit-modal" id="kit-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="kit-modal-title">
    <div class="kit-modal-backdrop" data-close-modal="true"></div>
    <div class="kit-modal-panel">
      <button class="kit-modal-close" type="button" aria-label="Cerrar detalle del kit">×</button>
      <div class="kit-modal-badge" id="kit-modal-label">Edición</div>
      <h3 id="kit-modal-title">Nombre del kit</h3>
      <p id="kit-modal-description">Descripción del kit.</p>
      <div class="kit-modal-meta">
        <span id="kit-modal-price">Próximamente</span>
        <span id="kit-modal-includes">Incluye cartas y misión</span>
      </div>
      <div class="kit-modal-actions">
        <button type="button" class="primary-button">Próximamente</button>
        <button type="button" class="secondary-button is-light" data-close-modal="true">Cerrar</button>
      </div>
    </div>
  </div>

  <script>
    const form = document.querySelector<HTMLFormElement>('#newsletter-form');
    const message = document.querySelector('#newsletter-message');
    const kitModal = document.querySelector<HTMLDivElement>('#kit-modal');
    const modalTitle = document.querySelector<HTMLElement>('#kit-modal-title');
    const modalDescription = document.querySelector<HTMLElement>('#kit-modal-description');
    const modalPrice = document.querySelector<HTMLElement>('#kit-modal-price');
    const modalLabel = document.querySelector<HTMLElement>('#kit-modal-label');
    const modalIncludes = document.querySelector<HTMLElement>('#kit-modal-includes');

    const openKitModal = (name: string, label: string, description: string, price: string) => {
      if (!kitModal || !modalTitle || !modalDescription || !modalPrice || !modalLabel || !modalIncludes) return;

      modalTitle.textContent = name;
      modalLabel.textContent = label;
      modalDescription.textContent = description;
      modalPrice.textContent = price || 'Próximamente';
      modalIncludes.textContent = name.includes('Secreto')
        ? 'Incluye 3 cartas, un mapa y 1 token de historia'
        : label.includes('Pronto')
          ? 'Disponible próximamente'
          : 'Incluye 3 cartas raras, caja de colección y accesorios premium';

      kitModal.classList.add('is-open');
      kitModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeKitModal = () => {
      if (!kitModal) return;
      kitModal.classList.remove('is-open');
      kitModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    document.querySelectorAll<HTMLButtonElement>('.kit-trigger').forEach((button) => {
      button.addEventListener('click', () => {
        openKitModal(
          button.dataset.kitName || 'Kit Nehnemi',
          button.dataset.kitLabel || 'Edición',
          button.dataset.kitDescription || 'Más información del kit.',
          button.dataset.kitPrice || 'Próximamente',
        );
      });
    });

    document.querySelectorAll<HTMLElement>('[data-close-modal="true"]').forEach((element) => {
      element.addEventListener('click', closeKitModal);
    });

    document.querySelector<HTMLButtonElement>('.kit-modal-close')?.addEventListener('click', closeKitModal);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && kitModal?.classList.contains('is-open')) {
        closeKitModal();
      }
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const payload = {
        name: String(formData.get('name') ?? '').trim(),
        email: String(formData.get('email') ?? '').trim(),
      };

      if (!payload.name || !payload.email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.email)) {
        if (message) {
          message.textContent = 'Completa tu nombre y un correo válido para unirte a la Sociedad.';
          message.className = 'form-status error';
        }
        return;
      }

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.error || 'No pudimos registrar tus datos en este momento.');
        }

        if (message) {
          message.textContent = result.message || '¡Bienvenido Cronista! El primer secreto va en camino.';
          message.className = 'form-status success';
        }

        form.reset();
      } catch (error) {
        if (message) {
          message.textContent = error instanceof Error ? error.message : 'Ocurrió un problema inesperado.';
          message.className = 'form-status error';
        }
      }
    });

    const cards = Array.from(document.querySelectorAll('.character-card'));
    const indicators = Array.from(document.querySelectorAll<HTMLElement>('.indicator'));
    const controls = Array.from(document.querySelectorAll<HTMLButtonElement>('.carousel-control'));
    let activeIndex = 0;

    function renderCarousel(nextIndex: number) {
      activeIndex = (nextIndex + cards.length) % cards.length;

      cards.forEach((card, index) => {
        card.classList.remove('is-active', 'is-prev', 'is-next');
        if (index === activeIndex) card.classList.add('is-active');
        if (index === (activeIndex - 1 + cards.length) % cards.length) card.classList.add('is-prev');
        if (index === (activeIndex + 1) % cards.length) card.classList.add('is-next');
      });

      indicators.forEach((indicator, index) => {
        indicator.classList.toggle('is-active', index === activeIndex);
      });
    }

    controls.forEach((button) => {
      button.addEventListener('click', () => {
        const dir = button.dataset.dir === 'next' ? 1 : -1;
        renderCarousel(activeIndex + dir);
      });
    });

    indicators.forEach((indicator) => {
      indicator.addEventListener('click', () => {
        renderCarousel(Number(indicator.dataset.index));
      });
    });

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        card.classList.toggle('is-flipped');
      });
    });

    renderCarousel(0);
  </script>
</Layout>

<style>
  .page-shell {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    padding-bottom: 3rem;
  }

  .section-shell {
    padding: 2rem 0 3rem;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(1200px, calc(100% - 2rem));
    margin: 1rem auto 0;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(212, 175, 55, 0.18);
    border-radius: 18px;
    background: rgba(26, 22, 18, 0.82);
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.18);
  }

  .brand-block {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    font-family: 'Cinzel', serif;
    font-size: 1.28rem;
    font-weight: 700;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.7rem;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.22), rgba(212, 175, 55, 0.08));
    border: 1px solid rgba(212, 175, 55, 0.3);
    color: var(--sepia-strong);
  }

  .topnav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  .topnav a {
    transition: color 0.2s ease;
  }

  .topnav a:hover {
    color: var(--sepia);
  }

  .nav-cta,
  .primary-button,
  .secondary-button,
  .kit-footer button,
  .carousel-control,
  .indicator {
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .nav-cta,
  .primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.2rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--sepia-strong), #b18a1a);
    color: #1f1914;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 12px 28px rgba(212, 175, 55, 0.18);
  }

  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.2rem;
    border-radius: 999px;
    border: 1px solid rgba(212, 175, 55, 0.28);
    background: transparent;
    color: var(--ink);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .nav-cta:hover,
  .primary-button:hover,
  .secondary-button:hover,
  .kit-footer button:hover,
  .carousel-control:hover,
  .indicator:hover {
    transform: translateY(-1px);
  }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2.5rem;
    align-items: center;
    padding-top: 3.5rem;
  }

  .hero-copy {
    display: grid;
    gap: 1.2rem;
    position: relative;
    z-index: 1;
  }

  .hero-tag,
  .eyebrow {
    display: inline-flex;
    width: fit-content;
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    background: rgba(212, 175, 55, 0.08);
    border: 1px solid rgba(212, 175, 55, 0.24);
    color: var(--sepia-strong);
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 640px;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 0.92;
  }

  .hero-copy p {
    max-width: 620px;
    font-size: 1.08rem;
    color: var(--ink-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .hero-stats {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0;
    margin: 0.3rem 0 0;
  }

  .hero-stats li {
    min-width: 122px;
    display: grid;
    gap: 0.2rem;
    padding: 0.8rem 1rem;
    border-radius: 18px;
    border: 1px solid rgba(212, 175, 55, 0.16);
    background: rgba(34, 28, 22, 0.8);
  }

  .hero-stats strong {
    color: var(--sepia);
    font-size: 1.6rem;
    line-height: 1;
  }

  .hero-stats span {
    color: var(--ink-muted);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-visual {
    position: relative;
    min-height: 520px;
    border-radius: 32px;
    border: 1px solid rgba(212, 175, 55, 0.18);
    background:
      radial-gradient(circle at top, rgba(212, 175, 55, 0.15), transparent 34%),
      linear-gradient(180deg, rgba(34, 28, 22, 0.82), rgba(18, 15, 13, 0.85));
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 30px 55px rgba(0,0,0,0.25);
  }

  .hero-visual::before {
    content: '';
    position: absolute;
    inset: 12% 18% 12% 18%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.12), transparent 62%);
    filter: blur(12px);
  }

  .trading-card {
    position: absolute;
    width: min(270px, 55vw);
    aspect-ratio: 0.7;
    border-radius: 20px;
    transform-style: preserve-3d;
    animation: floatCard 6s ease-in-out infinite;
    z-index: 2;
    perspective: 1200px;
  }

  .trading-card--main {
    right: 20%;
    bottom: 32px;
    transform: rotate(-9deg) translateY(12px);
    z-index: 3;
    animation-delay: 0s;
  }

  .trading-card--left {
    left: 18%;
    bottom: 36px;
    transform: rotate(-18deg) scale(0.9);
    z-index: 1;
    animation-delay: 1.6s;
  }

  .trading-card--right {
    right: 10%;
    top: 52px;
    transform: rotate(14deg) scale(0.92);
    z-index: 2;
    animation-delay: 0.9s;
  }

  .card-frame {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0.9rem;
