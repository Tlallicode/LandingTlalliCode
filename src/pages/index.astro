    const cards = Array.from(document.querySelectorAll('.character-card'));
    const indicators = Array.from(document.querySelectorAll<HTMLElement>('.indicator'));
    const controls = Array.from(document.querySelectorAll<HTMLButtonElement>('.carousel-control'));
    let activeIndex = 0;

    function renderCarousel(nextIndex: number) {
      activeIndex = (nextIndex + cards.length) % cards.length;

      cards.forEach((card, index) => {
        card.classList.remove('is-active', 'is-prev', 'is-next');
        if (index === activeIndex) card.classList.add('is-active');
        if (index === (activeIndex - 1 + cards.length) % cards.length) card.classList.add('is-prev');
        if (index === (activeIndex + 1) % cards.length) card.classList.add('is-next');
      });

      indicators.forEach((indicator, index) => {
        indicator.classList.toggle('is-active', index === activeIndex);
      });
    }

    controls.forEach((button) => {
      button.addEventListener('click', () => {
        const dir = button.dataset.dir === 'next' ? 1 : -1;
        renderCarousel(activeIndex + dir);
      });
    });

    indicators.forEach((indicator) => {
      indicator.addEventListener('click', () => {
        renderCarousel(Number(indicator.dataset.index));
      });
    });

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        card.classList.toggle('is-flipped');
      });
    });

    const carouselWindow = document.querySelector<HTMLElement>('.carousel-window');
    let carouselTouchStartX = 0;
    let carouselTouchStartY = 0;

    carouselWindow?.addEventListener(
      'touchstart',
      (event) => {
        const touch = event.changedTouches[0];
        carouselTouchStartX = touch.clientX;
        carouselTouchStartY = touch.clientY;
      },
      { passive: true },
    );

    carouselWindow?.addEventListener(
      'touchend',
      (event) => {
        const touch = event.changedTouches[0];
        const deltaX = touch.clientX - carouselTouchStartX;
        const deltaY = touch.clientY - carouselTouchStartY;

        if (Math.abs(deltaX) < 45 || Math.abs(deltaX) < Math.abs(deltaY)) return;
        renderCarousel(activeIndex + (deltaX < 0 ? 1 : -1));
      },
      { passive: true },
    );

    const heroVisual = document.querySelector<HTMLElement>('.hero-visual');
    const heroFocusTargets = Array.from(
      document.querySelectorAll<HTMLElement>('.hero-visual .phone-mockup, .hero-visual .trading-card'),
    );
    let heroFocusIndex = 0;
    let heroTouchStartX = 0;
    let heroTouchStartY = 0;

    function focusHeroTarget(nextIndex: number) {
      heroFocusIndex = (nextIndex + heroFocusTargets.length) % heroFocusTargets.length;
      heroFocusTargets.forEach((target, index) => {
        target.classList.toggle('is-focused', index === heroFocusIndex);
      });
    }

    heroFocusTargets.forEach((target, index) => {
      target.addEventListener('click', () => focusHeroTarget(index));
    });

    heroVisual?.addEventListener(
      'touchstart',
      (event) => {
        const touch = event.changedTouches[0];
        heroTouchStartX = touch.clientX;
        heroTouchStartY = touch.clientY;
      },
      { passive: true },
    );

    heroVisual?.addEventListener(
      'touchend',
      (event) => {
        const touch = event.changedTouches[0];
        const deltaX = touch.clientX - heroTouchStartX;
        const deltaY = touch.clientY - heroTouchStartY;

        if (Math.abs(deltaX) < 45 || Math.abs(deltaX) < Math.abs(deltaY)) return;
        focusHeroTarget(heroFocusIndex + (deltaX < 0 ? 1 : -1));
      },
      { passive: true },
    );

    focusHeroTarget(0);
    renderCarousel(0);
  </script>
</Layout>

