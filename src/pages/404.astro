---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada | Nehnemi" description="La página que buscabas no existe o fue movida.">
  <main class="not-found">
    <section class="card">
      <p class="code">404</p>
      <h1>La ruta no existe</h1>
      <p>
        Parece que esta pista se perdió entre los archivos del tiempo. Regresa al inicio para continuar
        la exploración.
      </p>
      <a href="/" class="home-btn">Volver al inicio</a>
    </section>
  </main>
</Layout>

<style>
  .not-found {
    min-height: 100vh;
    display: grid;
    place-items: center;
    width: min(980px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0;
  }

  .card {
    width: min(640px, 100%);
    border: 1px solid rgba(212, 175, 55, 0.24);
    background: rgba(33, 27, 22, 0.88);
    border-radius: 24px;
    padding: 2rem;
    display: grid;
    gap: 1rem;
    text-align: center;
  }

  .code {
    font-family: 'Cinzel', serif;
    font-size: 3rem;
    color: var(--sepia-strong);
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(1.9rem, 4vw, 2.7rem);
  }

  .home-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    background: linear-gradient(135deg, var(--sepia-strong), #b18a1a);
    color: #201a16;
    border-radius: 999px;
    padding: 0.85rem 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 800;
  }
</style>
